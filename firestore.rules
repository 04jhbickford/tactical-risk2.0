rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile; other authenticated users can read profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin check (game moderation) — keep in sync with LobbyManager.ADMIN_EMAILS
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'bickford.james@gmail.com';
    }

    // Dice stats (observe-only). Limits, documented for reviewers:
    // - diceBatches are create-only. writerUid must be the signed-in user.
    //   Same id (game_round_nonce_seq_uid) makes a retry fail closed, so it
    //   cannot double-count. Rules check the envelope plus the first and last
    //   die; rules have no list loop for every face in the middle.
    // - Face and n deltas are let-bound (Firestore allows 10 lets per function
    //   and 1000 expressions per request). Each face delta is >= 0, n's
    //   increase equals the face increases, and n's increase is <= 240.
    //   A missing counter defaults to 0, so deleteField() on a counter fails.
    // - High/low run deltas are >= 0 and <= 240. longestStreak may only rise.
    // - Unit, seat, and transition fields are not each matched. A signed-in
    //   client can add other numeric fields. That is the tradeoff for
    //   increment() without a composite of every unit type.
    // - displayName is an in-game name: short string, no '@'. No email field.
    // - player_{uid} can be written only by that uid. global and game_* by
    //   any signed-in user. Nobody can delete.
    function diceCountersOk() {
      let o = resource == null ? {} : resource.data;
      let a = request.resource.data;
      let d1 = a.get('face_1', 0) - o.get('face_1', 0);
      let d2 = a.get('face_2', 0) - o.get('face_2', 0);
      let d3 = a.get('face_3', 0) - o.get('face_3', 0);
      let d4 = a.get('face_4', 0) - o.get('face_4', 0);
      let d5 = a.get('face_5', 0) - o.get('face_5', 0);
      let d6 = a.get('face_6', 0) - o.get('face_6', 0);
      let dn = a.get('n', 0) - o.get('n', 0);
      return d1 >= 0 && d2 >= 0 && d3 >= 0 && d4 >= 0 && d5 >= 0 && d6 >= 0
        && dn == d1 + d2 + d3 + d4 + d5 + d6
        && dn <= 240;
    }
    function diceRunsOk() {
      let o = resource == null ? {} : resource.data;
      let a = request.resource.data;
      let hl = a.get('hl_low', 0) - o.get('hl_low', 0);
      let hh = a.get('hl_high', 0) - o.get('hl_high', 0);
      let hr = a.get('hl_runs', 0) - o.get('hl_runs', 0);
      return hl >= 0 && hl <= 240 && hh >= 0 && hh <= 240 && hr >= 0 && hr <= 240;
    }
    function diceStreakOk() {
      let old = resource == null ? 0 : resource.data.get('longestStreak', 0);
      return request.resource.data.get('longestStreak', 0) is int
        && request.resource.data.get('longestStreak', 0) >= old;
    }
    function diceNameOk(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 40
        && !name.matches('.*@.*');
    }
    function diceStatsIdOk(statId) {
      return statId == 'global'
        || statId.matches('^game_[A-Za-z0-9_\\-]{1,80}$')
        || statId == ('player_' + request.auth.uid);
    }
    function diceDieOk(d) {
      return d.keys().hasAll(['unit', 'face'])
        && d.unit is string
        && d.unit.size() <= 40
        && d.face is int
        && d.face >= 1
        && d.face <= 6
        && (!('need' in d) || d.need == null || (d.need is number && d.need >= 0 && d.need <= 6));
    }

    // Lobbies: any authenticated user can create, read, or update lobbies.
    // Only the host (creator) or an admin can delete a lobby.
    match /lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if (request.auth != null
                       && request.auth.uid == resource.data.hostId)
                    || isAdmin();
    }

    // Games: any authenticated user can create, read, or update games.
    // Delete is admin, or a seated player after the game is finished
    // (all-resign / no seated humans — client then deleteDoc).
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin()
        || (request.auth != null
            && resource.data.status == 'finished'
            && request.auth.uid in resource.data.playerUserIds);

      // Presence lives in a SUBCOLLECTION of each game. Rules do not cascade —
      // without this block every presence read/write is silently denied, which
      // is why online indicators never worked.
      match /presence/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Append-only diagnostics timeline. Does not cascade from /games.
      // Clients may create events for a game they are seated in (or started).
      // Bulk / cross-game pull is admin-only — see DIAGNOSTICS.md.
      match /events/{eventId} {
        function canAppendGameEvent() {
          let game = get(/databases/$(database)/documents/games/$(gameId)).data;
          return request.auth != null && (
            isAdmin()
            || (game.keys().hasAny(['playerUserIds'])
                && request.auth.uid in game.playerUserIds)
            || request.auth.uid == game.startedBy
          );
        }

        allow create: if canAppendGameEvent()
          && request.resource.data.keys().hasAll(['ts', 'kind', 'writerUid'])
          && request.resource.data.kind in [
            'phase', 'move', 'attack', 'aa', 'combat',
            'purchase', 'retreat', 'error', 'ui'
          ]
          && request.resource.data.writerUid == request.auth.uid;
        allow read: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Legacy top-level presence collection (unused by current code, kept for
    // any stale clients)
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Observe-only dice log. Create once; no update or delete.
    match /diceBatches/{batchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.writerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'gameId', 'round', 'turnPhase', 'context', 'side', 'playerSeat',
          'isAI', 'writerUid', 'clientVersion', 'ts', 'dice'
        ])
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() > 0
        && request.resource.data.gameId.size() <= 80
        && request.resource.data.round is int
        && request.resource.data.turnPhase is string
        && request.resource.data.turnPhase.size() <= 40
        && request.resource.data.context in ['combat', 'aa', 'bombard', 'sub', 'rocket', 'tech']
        && request.resource.data.side in ['attacker', 'defender']
        && request.resource.data.playerSeat is string
        && request.resource.data.playerSeat.size() <= 80
        && request.resource.data.isAI is bool
        && request.resource.data.writerUid is string
        && request.resource.data.clientVersion is string
        && request.resource.data.clientVersion.size() <= 80
        && request.resource.data.ts is number
        && request.resource.data.dice is list
        && request.resource.data.dice.size() > 0
        && request.resource.data.dice.size() <= 240
        && diceDieOk(request.resource.data.dice[0])
        && diceDieOk(request.resource.data.dice[request.resource.data.dice.size() - 1])
        && !('email' in request.resource.data);
      allow update, delete: if false;
    }

    // Running totals. Readable by any signed-in user. Writes are increments
    // (and a monotonic longestStreak) from a signed-in client.
    match /diceStats/{statId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && diceStatsIdOk(statId)
        && request.resource.data.size() < 800
        && diceCountersOk()
        && diceRunsOk()
        && diceStreakOk()
        && !('email' in request.resource.data)
        && (!('displayName' in request.resource.data)
            || diceNameOk(request.resource.data.displayName));
      allow delete: if false;
    }
  }
}
